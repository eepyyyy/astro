{
  "name": "jamakkol-hora-studio",
  "version": "10.0.0",
  "description": "Jamakkol Hora Studio — Obsidian-Stack Desktop Application (Electron + Vanilla JS + CodeMirror + Local Markdown Vault)",
  "main": "electron/main.js",
  "author": "Jamakkol Hora Studio",
  "license": "MIT",
  "scripts": {
    "start": "node electron/launch.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "codemirror": "^5.65.18"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jamakkol.horastudio",
    "productName": "Jamakkol Hora Studio",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "electron/**/*",
      "static/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/JamakkolHoraStudio",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/app_icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jamakkol Hora Studio"
    }
  }
}
